---
import SiteLayout from "../../layouts/SiteLayout.astro"; import ServicesPage from "../../components/ServicesPage.astro"; import { languages, type Lang } from "../../data/portfolio";
export function getStaticPaths() { return languages.map((lang) => ({ params: { lang } })); } const { lang } = Astro.params as { lang: Lang };
---
<SiteLayout {lang} current="/services" title={lang === "es" ? "Servicios" : "Services"}><ServicesPage {lang} /></SiteLayout>
