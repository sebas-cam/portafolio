---
import { buildPrinciples, numbers, profile, projects, type Lang } from "../data/portfolio";
const { lang } = Astro.props as { lang: Lang };
const prefix = lang === "es" ? "/es" : "";
const copy = lang === "es" ? {
  eyebrow: "Ingeniero full stack · Lima, Perú", hero: "Creo productos centrados en WhatsApp con IA.", sub: "Diseño, lanzo y opero mis propios SaaS — desde el agente de IA hasta la infraestructura.", work: "Trabajo seleccionado", all: "Ver todos los proyectos", numbers: "En números", approach: "Cómo trabajo", contact: "¿Tienes un producto que lanzar?", talk: "Hablemos",
} : {
  eyebrow: "Full stack engineer · Lima, Peru", hero: "I build WhatsApp-first products with AI.", sub: "I design, ship and run my own SaaS — from the AI agent to the infrastructure.", work: "Selected work", all: "View all projects", numbers: "In numbers", approach: "How I build", contact: "Have a product to ship?", talk: "Let's talk",
};
---
<section class="hero"><div class="wrap"><p class="eyebrow">{copy.eyebrow}</p><h1>{copy.hero}</h1><p>{copy.sub}</p><div class="actions"><a class="button primary" href={`${prefix}/projects`}>{copy.work} ↗</a><a class="button" href="/resume/Sebastian_Campos_CV.pdf" download>{lang === "es" ? "Descargar CV ↓" : "Download CV ↓"}</a></div></div></section>
<section class="section" id="work"><div class="section-head"><p class="eyebrow">/ 01</p><h2>{copy.work}</h2><a class="meta" href={`${prefix}/projects`}>{copy.all} →</a></div><div class="cards">{projects.slice(0, 3).map((project) => <a class="project" href={`${prefix}/projects/${project.slug}`}><div><div class="project-top"><span class="meta">{project.year}</span><span class="tag">{project.status[lang]}</span></div><h3>{project.name}</h3><p>{project.tagline[lang]}</p></div><div class="chips">{project.stack.slice(0, 5).map((tech) => <span class="chip">{tech}</span>)}</div></a>)}</div></section>
<section class="section"><div class="section-head"><p class="eyebrow">/ 02</p><h2>{copy.numbers}</h2></div><div class="metrics">{numbers.map((item) => <article class="metric"><strong>{item.value}</strong><p>{item[lang]}</p>{item.detail && <small>{item.detail}</small>}</article>)}</div></section>
<section class="section"><div class="section-head"><p class="eyebrow">/ 03</p><h2>{copy.approach}</h2></div><div class="three-col">{buildPrinciples.map((item) => <article class="card"><h3>{item[lang]}</h3><p>{lang === "es" ? item.bodyEs : item.bodyEn}</p></article>)}</div></section>
<section class="section"><p class="eyebrow">/ 04</p><h2>{copy.contact}</h2><div class="actions"><a class="button primary" href={`${prefix}/contact`}>{copy.talk} →</a><a class="button" href={`mailto:${profile.email}`}>{profile.email}</a></div></section>
