---
import SiteLayout from "../../layouts/SiteLayout.astro"; import ContactPage from "../../components/ContactPage.astro"; import { languages, type Lang } from "../../data/portfolio";
export function getStaticPaths() { return languages.map((lang) => ({ params: { lang } })); } const { lang } = Astro.params as { lang: Lang };
---
<SiteLayout {lang} current="/contact" title={lang === "es" ? "Contacto" : "Contact"}><ContactPage {lang} /></SiteLayout>
