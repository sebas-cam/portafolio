---
import { navigation, profile, type Lang } from "../data/portfolio";
const { lang, current = "" } = Astro.props as { lang: Lang; current?: string };
const prefix = lang === "es" ? "/es" : "";
const other = lang === "es" ? "en" : "es";
const otherHref = lang === "es" ? current || "/" : `/es${current || "/"}`;
---
<header class="site-header">
  <a class="brand" href={prefix || "/"} aria-label={`${profile.name} home`}>
    <span>{profile.name}</span><small>{profile.role[lang]}</small>
  </a>
  <nav aria-label={lang === "es" ? "Navegación principal" : "Primary navigation"}>
    {navigation.map((item) => {
      const href = item.href ? `${prefix}${item.href}` : (prefix || "/");
      return <a class:list={{ active: current === item.href }} href={href}>{item[lang]}</a>;
    })}
  </nav>
  <a class="language" href={otherHref} hreflang={other}>{other.toUpperCase()}</a>
</header>
