---
import SiteLayout from "../../../layouts/SiteLayout.astro"; import ProjectsPage from "../../../components/ProjectsPage.astro"; import { languages, type Lang } from "../../../data/portfolio";
export function getStaticPaths() { return languages.map((lang) => ({ params: { lang } })); } const { lang } = Astro.params as { lang: Lang };
---
<SiteLayout {lang} current="/projects" title={lang === "es" ? "Proyectos" : "Projects"}><ProjectsPage {lang} /></SiteLayout>
