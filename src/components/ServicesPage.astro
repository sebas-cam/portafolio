---
import { services, type Lang } from "../data/portfolio";
const { lang } = Astro.props as { lang: Lang };
const prefix = lang === "es" ? "/es" : "";
const copy = lang === "es" ? { title:"Servicios", intro:"De una idea validada a un producto que tus usuarios pueden usar.", process:"Proceso", steps:["Entender el problema", "Definir el alcance", "Construir y probar", "Lanzar y mejorar"], cta:"Hablemos de tu proyecto" } : { title:"Services", intro:"From a validated idea to a product your users can use.", process:"Process", steps:["Understand the problem", "Define the scope", "Build and test", "Launch and improve"], cta:"Let's talk about your project" };
---
<section class="page-hero"><p class="eyebrow">/ 04</p><h1>{copy.title}</h1><p>{copy.intro}</p></section>
<section class="section"><div class="service-grid">{services.map((service, index) => <article class="card"><p class="eyebrow">0{index + 1}</p><h3>{service[lang]}</h3><p>{lang === "es" ? service.bodyEs : service.bodyEn}</p></article>)}</div></section>
<section class="section"><div class="section-head"><p class="eyebrow">/ 02</p><h2>{copy.process}</h2></div><div class="metrics">{copy.steps.map((step, index) => <article class="metric"><strong>0{index + 1}</strong><p>{step}</p></article>)}</div></section>
<section class="section"><h2>{copy.cta}</h2><div class="actions"><a class="button primary" href={`${prefix}/contact`}>{lang === "es" ? "Contacto →" : "Contact →"}</a></div></section>
