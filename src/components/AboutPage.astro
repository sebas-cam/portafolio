---
import { experience, profile, stackGroups, type Lang } from "../data/portfolio";
const { lang } = Astro.props as { lang: Lang };
const prefix = lang === "es" ? "/es" : "";
const copy = lang === "es" ? { title:"Sobre mí", intro:"Construyo productos web completos y automatizaciones con IA para problemas de negocio reales.", experience:"Experiencia", stack:"Stack", education:"Formación", cv:"Descargar CV ↓" } : { title:"About", intro:"I build complete web products and AI automations for real business problems.", experience:"Experience", stack:"Stack", education:"Education", cv:"Download CV ↓" };
---
<section class="page-hero"><p class="eyebrow">/ 03</p><h1>{copy.title}</h1><p>{copy.intro}</p></section>
<section class="section"><div class="section-head"><p class="eyebrow">/ 01</p><h2>{copy.experience}</h2></div><div class="timeline">{experience.map((job) => <article><p class="meta">{lang === "es" ? job.periodEs : job.periodEn}</p><div><h3>{lang === "es" ? job.roleEs : job.roleEn}</h3><h4>{lang === "es" ? job.orgEs : job.orgEn}</h4><p>{lang === "es" ? job.bodyEs : job.bodyEn}</p></div></article>)}</div></section>
<section class="section"><div class="section-head"><p class="eyebrow">/ 02</p><h2>{copy.stack}</h2></div><div class="stack">{stackGroups.map((group) => <article class="card"><h3>{group[lang]}</h3><ul>{group.items.map((item) => <li class="chip">{item}</li>)}</ul></article>)}</div></section>
<section class="section"><div class="section-head"><p class="eyebrow">/ 03</p><h2>{copy.education}</h2></div><div class="three-col"><article class="card"><h3>{lang === "es" ? "Desarrollo de Software" : "Software Development"}</h3><p>ISIL, Lima · 2020–2023</p></article><article class="card"><h3>{lang === "es" ? "Computación e Informática" : "Computing and Informatics"}</h3><p>Cibertec · {lang === "es" ? "En curso" : "In progress"}</p></article><article class="card"><h3>{lang === "es" ? "Idiomas" : "Languages"}</h3><p>{lang === "es" ? "Español nativo · Inglés C1 (ICPNA)" : "Spanish native · English C1 (ICPNA)"}</p></article></div><div class="actions"><a class="button primary" href="/resume/Sebastian_Campos_CV.pdf" download>{copy.cv}</a><a class="button" href={`${prefix}/contact`}>{profile.email}</a></div></section>
