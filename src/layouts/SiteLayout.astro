---
import "../styles/portfolio.css";
import SiteHeader from "../components/SiteHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";
import { profile, type Lang } from "../data/portfolio";
const { lang, title, description, current = "" } = Astro.props as { lang: Lang; title?: string; description?: string; current?: string };
const pageTitle = title ? `${title} — ${profile.name}` : `${profile.name} — ${profile.role[lang]}`;
const path = Astro.url.pathname;
const alternate = lang === "es" ? path.replace(/^\/es/, "") || "/" : `/es${path === "/" ? "/" : path}`;
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description ?? (lang === "es" ? "Portafolio de Sebastian Campos, ingeniero full stack." : "Portfolio of Sebastian Campos, full stack engineer.")} />
    <meta name="theme-color" content="#201c17" />
    <link rel="icon" href="/favicon.png" />
    <link rel="alternate" hreflang={lang === "es" ? "en" : "es"} href={alternate} />
    <title>{pageTitle}</title>
  </head>
  <body>
    <SiteHeader {lang} {current} />
    <main><slot /></main>
    <SiteFooter {lang} />
  </body>
</html>
