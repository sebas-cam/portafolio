---
import { profile, type Lang } from "../data/portfolio";
const { lang } = Astro.props as { lang: Lang };
const copy = lang === "es" ? { title:"Contacto", intro:"Para roles full-time, colaboraciones o proyectos freelance.", name:"Tu nombre", email:"Tu email", message:"Cuéntame sobre el proyecto", send:"Abrir correo →", note:"El formulario abre tu cliente de correo con los datos que completes.", location:"Ubicación" } : { title:"Contact", intro:"For full-time roles, collaborations or freelance projects.", name:"Your name", email:"Your email", message:"Tell me about the project", send:"Open email →", note:"The form opens your email client with the details you enter.", location:"Location" };
---
<section class="page-hero"><p class="eyebrow">/ 05</p><h1>{copy.title}</h1><p>{copy.intro}</p></section>
<section class="section"><div class="contact"><form id="contact-form"><input id="name" required placeholder={copy.name} /><input id="email" type="email" required placeholder={copy.email} /><textarea id="message" required minlength="10" rows="6" placeholder={copy.message}></textarea><button class="button primary" type="submit">{copy.send}</button><p class="note">{copy.note}</p></form><div class="contact-links"><div><span class="eyebrow">Email</span><a href={`mailto:${profile.email}`}>{profile.email}</a></div><div><span class="eyebrow">GitHub</span><a href={profile.social.github} target="_blank" rel="noreferrer">github.com/sebas-cam ↗</a></div><div><span class="eyebrow">LinkedIn</span><a href={profile.social.linkedin} target="_blank" rel="noreferrer">LinkedIn ↗</a></div><div><span class="eyebrow">X / Twitter</span><a href={profile.social.x} target="_blank" rel="noreferrer">Building in public ↗</a></div><div><span class="eyebrow">CV</span><a href="/resume/Sebastian_Campos_CV.pdf" download>{lang === "es" ? "Descargar CV ↓" : "Download CV ↓"}</a></div><div><span class="eyebrow">{copy.location}</span><p>{profile.location[lang]}</p></div></div></div></section>
<script>
  const form = document.querySelector<HTMLFormElement>("#contact-form");
  form?.addEventListener("submit", (event) => {
    event.preventDefault();
    const name = (document.querySelector<HTMLInputElement>("#name")?.value ?? "").trim();
    const email = (document.querySelector<HTMLInputElement>("#email")?.value ?? "").trim();
    const message = (document.querySelector<HTMLTextAreaElement>("#message")?.value ?? "").trim();
    if (!name || !email || message.length < 10) return;
    window.location.href = `mailto:sebastian.campos.dev@gmail.com?subject=${encodeURIComponent(`Portfolio inquiry from ${name}`)}&body=${encodeURIComponent(`${message}\n\n— ${name} (${email})`)}`;
  });
</script>
