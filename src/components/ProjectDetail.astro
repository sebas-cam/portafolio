---
import { groomie, projects, type Lang } from "../data/portfolio";
const { lang, slug } = Astro.props as { lang: Lang; slug: string };
const project = projects.find((item) => item.slug === slug);
if (!project) return Astro.redirect(lang === "es" ? "/es/projects" : "/projects");
const prefix = lang === "es" ? "/es" : "";
const isGroomie = slug === "groomie";
const copy = lang === "es" ? { visit:"Visitar sitio", back:"Volver a proyectos", problem:"El problema", solution:"La solución", features:"Funcionalidades", decisions:"Decisiones técnicas", architecture:"Arquitectura", stack:"Stack", role:"Mi rol", results:"Resultados", simple:"Este caso resume el producto, el problema que resuelve y la implementación que lo sostiene." } : { visit:"Visit site", back:"Back to projects", problem:"The problem", solution:"The solution", features:"Features", decisions:"Technical decisions", architecture:"Architecture", stack:"Stack", role:"My role", results:"Results", simple:"This case outlines the product, the problem it solves and the implementation behind it." };
const architecture = lang === "es" ? ["Cliente en WhatsApp", "Evolution API (autohospedada, Baileys)", "Agente IA en n8n (OpenAI)", "API de Groomie (Next.js)", "MongoDB por tenant + Redis para sesión y handoff", "Ably en tiempo real", "Panel del dueño"] : ["WhatsApp customer", "Evolution API (self-hosted, Baileys)", "n8n AI agent (OpenAI)", "Groomie API (Next.js)", "MongoDB per tenant + Redis for session and handoff", "Ably real-time", "Owner dashboard"];
---
<section class="page-hero"><p class="eyebrow">{project.year} · {project.status[lang]}</p><h1>{project.name}</h1><p>{project.tagline[lang]}</p><div class="actions">{project.url && <a class="button primary" href={project.url} target="_blank" rel="noreferrer">{copy.visit} ↗</a>}<a class="button" href={`${prefix}/projects`}>← {copy.back}</a></div></section>
{isGroomie ? <>
  <section class="section"><p class="eyebrow">/ 01</p><h2>{copy.problem}</h2><p class="case-copy">{groomie.problem[lang]}</p></section>
  <section class="section"><p class="eyebrow">/ 02</p><h2>{copy.solution}</h2><p class="case-copy">{groomie.solution[lang]}</p></section>
  <section class="section"><p class="eyebrow">/ 03</p><h2>{copy.features}</h2><ol class="feature-list">{groomie.features.map((feature, index) => <li><span class="eyebrow">0{index + 1} / </span>{feature[lang]}</li>)}</ol></section>
  <section class="section"><p class="eyebrow">/ 04</p><h2>{copy.decisions}</h2><div class="three-col">{groomie.decisions.map((item) => <article class="card"><h3>{lang === "es" ? item.titleEs : item.titleEn}</h3><p>{lang === "es" ? item.bodyEs : item.bodyEn}</p></article>)}</div></section>
  <section class="section"><p class="eyebrow">/ 05</p><h2>{copy.architecture}</h2><div class="architecture">{architecture.map((node, index) => <><span>{node}</span>{index < architecture.length - 1 && <i>↓</i>}</>)}</div></section>
  <section class="section"><p class="eyebrow">/ 06</p><h2>{copy.stack}</h2><div class="chips">{groomie.stack.map((item) => <span class="chip">{item}</span>)}</div></section>
  <section class="section"><p class="eyebrow">/ 07</p><h2>{copy.role}</h2><p class="case-copy">{lang === "es" ? "Diseñé y construí todo el producto: producto, frontend, backend, el flujo del bot en n8n, infraestructura y marca." : "I designed and built the whole product solo: product, frontend, backend, the bot flow in n8n, infrastructure and brand."}</p><p class="case-copy">{lang === "es" ? "2 negocios · ~20 reservas/día · ~600 reservas/mes" : "2 businesses · ~20 bookings/day · ~600 bookings/month"}</p></section>
</> : <section class="section"><p class="eyebrow">/ 01</p><h2>{copy.problem}</h2><p class="case-copy">{copy.simple}</p><div class="chips">{project.stack.map((item) => <span class="chip">{item}</span>)}</div></section>}
